generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  username  String    @unique
  name             String
  avatarId         String?   @default("kedi")
  bio              String?
  city             String?
  district         String?
  photoUrl         String?
  personalityTags  String?
  onboardingDone   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  cards            Card[]
  gnoCards         GNOCard[]
}

model Card {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  recipientName String
  slug          String
  theme         String    @default("minimal")

  option1Label  String    @default("🍕 Pizza")
  option2Label  String    @default("🍦 Dondurma")
  option3Label  String    @default("☕ Kahve")
  option4Label  String    @default("🍸 Kokteyl")
  option5Label  String    @default("🎨 Workshop")
  option6Label  String    @default("🍺 Bar")

  suggestSelect   String?
  suggestDatetime String?
  suggestLocation String?
  suggestPickup   String?

  status         String    @default("pending")
  selectedOption String?
  selectedDate   DateTime?
  pickupChoice   Boolean?
  location       String?
  withBarAfter   Boolean   @default(false)

  venueCity         String?
  venueDistrict     String?
  suggestedVenueId  String?
  selectedVenueId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
}

model Venue {
  id              String   @id @default(uuid())
  name            String
  category        String
  city            String
  district        String
  address         String?
  googleMapsUrl   String?
  instagramUrl    String?
  instagramSearch String?
  rating          Float?
  priceLevel      Int?
  imageUrl        String?
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  googlePlaceId   String?  @unique
  googleRating    Float?
  totalRatings    Int?
  reviewsJson     String?
  photosJson      String?
  openingHours    String?
  phone           String?
  website         String?
  googleMapsUri   String?
  aiAnalysis      String?
  dateSkor        Float?
  gnoSkor         Float?
  atmosfer        String?
  aiTags          String?

  venueType     String?  @default("mekan")
  isNature      Boolean  @default(false)
  beachType     String?
  swimSuitable  Boolean?
}

model GNOCard {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  groupName String
  slug      String
  theme     String    @default("rosy")

  option1Label String @default("🍕 Pizza")
  option2Label String @default("🍦 Dondurma")
  option3Label String @default("☕ Kahve")
  option4Label String @default("🍸 Kokteyl")
  option5Label String @default("🎨 Workshop")
  option6Label String @default("🍺 Bar")

  time1Label String @default("Cuma 20:00")
  time2Label String @default("Cumartesi 20:00")
  time3Label String @default("Pazar 18:00")

  location1Label String @default("Kadıköy")
  location2Label String @default("Beşiktaş")
  location3Label String @default("Nişantaşı")

  votes     GNOVote[]

  venueCity        String?
  venueDistrict    String?
  suggestedVenueId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
}

model GNOVote {
  id               String  @id @default(uuid())
  cardId           String
  card             GNOCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  voterName        String
  selectedEvent    String
  selectedTime     String
  selectedLocation String
  pickupChoice     String   @default("meet")
  selectedVenueId  String?
  createdAt        DateTime @default(now())
}

model VenueSubmission {
  id             String    @id @default(uuid())
  name           String
  category       String
  city           String
  district       String
  address        String?
  googleMapsUrl  String?
  instagramUrl   String?
  rating         Float?
  priceLevel     Int?
  description    String?
  submitterName  String?
  submitterEmail String?
  status         String    @default("pending")
  adminNote      String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
}
