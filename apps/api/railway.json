{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd ../../server && npm install --include=dev && npm run build"
  },
  "deploy": {
    "startCommand": "cd ../../server && npm start",
    "watchPatterns": ["/server/**"],
    "restartPolicyType": "ON_FAILURE"
  }
}
